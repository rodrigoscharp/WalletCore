# Copie para .env e ajuste. O .env é git-ignored.
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run

# Obrigatório: chave HMAC de assinatura dos JWTs. A aplicação não sobe sem ela.
# Mínimo 32 caracteres. Gere a sua com: openssl rand -hex 32
JWT_SECRET=

# Opcionais — os defaults abaixo já batem com o docker-compose.yml para rodar local.
# DB_URL=jdbc:postgresql://localhost:5432/walletcore
# DB_USERNAME=walletcore
# DB_PASSWORD=walletcore_secret

# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=walletcore
# RABBITMQ_PASSWORD=walletcore_secret

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=walletcore_secret
